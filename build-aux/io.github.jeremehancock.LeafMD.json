{
    "id": "io.github.jeremehancock.LeafMD",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "leafmd",
    "finish-args": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--share=network",
        "--filesystem=home"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/leafmd/cargo"
        }
    },
    "modules": [
        {
            "name": "libspelling",
            "buildsystem": "meson",
            "config-opts": [
                "-Ddocs=false",
                "-Dintrospection=disabled",
                "-Dvapi=false",
                "-Dsysprof=false"
            ],
            "cleanup": [
                "/include",
                "/lib/pkgconfig"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libspelling/0.4/libspelling-0.4.11.tar.xz",
                    "sha256": "52e53ec3fba0f604cfd0931e26af7f7241a0d4f0208dd5574f43b3589f6d28b2",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "libspelling",
                        "stable-only": true
                    }
                }
            ]
        },
        {
            "name": "leafmd",
            "buildsystem": "simple",
            "build-commands": [
                "cargo --offline --config 'source.crates-io.replace-with=\"vendored-sources\"' --config 'source.vendored-sources.directory=\"vendor\"' build --release --locked",
                "install -Dm755 target/release/leafmd /app/bin/leafmd",
                "install -Dm644 data/io.github.jeremehancock.LeafMD.desktop /app/share/applications/io.github.jeremehancock.LeafMD.desktop",
                "install -Dm644 data/io.github.jeremehancock.LeafMD.metainfo.xml /app/share/metainfo/io.github.jeremehancock.LeafMD.metainfo.xml",
                "install -Dm644 data/icons/hicolor/scalable/apps/io.github.jeremehancock.LeafMD.svg /app/share/icons/hicolor/scalable/apps/io.github.jeremehancock.LeafMD.svg",
                "install -Dm644 data/icons/hicolor/symbolic/apps/io.github.jeremehancock.LeafMD-symbolic.svg /app/share/icons/hicolor/symbolic/apps/io.github.jeremehancock.LeafMD-symbolic.svg",
                "install -Dm644 data/icon-theme/LeafMD/index.theme /app/share/icons/LeafMD/index.theme",
                "install -Dm644 -t /app/share/icons/LeafMD/scalable/actions data/icon-theme/LeafMD/scalable/actions/*.svg"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "..",
                    "skip": [
                        "target",
                        ".flatpak-builder",
                        "flatpak-build",
                        ".git"
                    ]
                }
            ]
        }
    ]
}
